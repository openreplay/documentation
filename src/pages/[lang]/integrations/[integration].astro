---
import languages, { rtlLanguages } from '../../../i18n/languages';
import SplashLayout from '../../../layouts/SplashLayout.astro';
import { useTranslations } from '../../../i18n/util';
import { ARCHIVE_VERSION, REMOVED_INTEGRATIONS } from '../../../util/removedIntegrations';

/**
 * Tombstones for the integrations OpenReplay no longer supports.
 *
 * Deleting the `.mdx` files is not enough on its own: these URLs were live, linked
 * and indexed for years, so they survive in Google, in Algolia and in bookmarks.
 * This route keeps them resolving with an honest "this is gone" page instead of the
 * 404 robot, and carries `noindex` so crawlers drop them.
 *
 * KEEP THIS AN `.astro` FILE. The sitemap (`collectRealPaths` in integrations/sitemap.ts)
 * and the search index (`readFilesRecursively` in scripts/prepare-index.js) each build
 * their allowlist by walking src/pages for `*.mdx`, so an `.astro` route is invisible to
 * both by construction. That asymmetry IS the bug this fixes: in Nov 2024 (8999a56f) the
 * pages were dropped from the nav but left on disk as `.mdx`, so both walkers went on
 * publishing and indexing them under every locale and every version — which is why a
 * retired integration still 200'd and still showed up in docs search on v1.27.
 *
 * Only the current-version locale copies are tombstoned. The v1.17–v1.26 folders keep
 * the real pages: those releases genuinely shipped these integrations, and the archive
 * link below sends self-hosted users on an older release to them.
 */

export function getStaticPaths() {
	return Object.keys(languages).flatMap((lang) =>
		Object.keys(REMOVED_INTEGRATIONS).map((integration) => ({ params: { lang, integration } }))
	);
}

const { lang = 'en', integration = '' } = Astro.params;
const name = REMOVED_INTEGRATIONS[integration];
const t = useTranslations(Astro);
const dir = rtlLanguages.has(lang) ? 'rtl' : 'ltr';
---

<SplashLayout title={name} dir={dir} noindex>
	<div class="or-gone">
		<p class="or-gone-eyebrow">{t('removed.eyebrow')}</p>
		<h1 class="or-gone-title">{name}</h1>
		<p class="or-gone-desc">{t('removed.content')}</p>
		<a class="or-gone-btn" href={`/${lang}/integrations/`}>{t('removed.linkText')}</a>
		<p class="or-gone-archive">
			<a href={`/${lang}/${ARCHIVE_VERSION}/integrations/${integration}/`}>
				{t('removed.archiveText')}
			</a>
		</p>
	</div>
</SplashLayout>

<style>
	/* Mirrors the 404 page's splash treatment (see [lang]/404.astro) so a retired
	   integration reads as a deliberate dead end rather than a broken page. */
	.or-gone {
		text-align: center;
		max-width: 560px;
		margin-inline: auto;
		padding: 8px 0 16px;
	}
	.or-gone-eyebrow {
		font-family: var(--fb);
		font-weight: 700;
		font-size: 13px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0 0 6px;
	}
	.or-gone-title {
		font-family: var(--fd);
		font-weight: 700;
		font-size: clamp(28px, 5vw, 40px);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 0 0 12px;
	}
	.or-gone-desc {
		font-family: var(--fb);
		font-size: 16px;
		line-height: 1.5;
		color: var(--text-2);
		max-width: 46ch;
		margin: 0 auto 26px;
	}
	.or-gone-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding: 0 24px;
		border-radius: 9999px;
		background: var(--accent);
		color: #fff;
		font-family: var(--fb);
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		transition: background 0.2s ease, box-shadow 0.2s ease;
	}
	.or-gone-btn:hover {
		background: var(--accent-press);
		box-shadow: var(--shadow-md);
		color: #fff;
	}
	.or-gone-archive {
		font-family: var(--fb);
		font-size: 14px;
		color: var(--text-2);
		margin: 18px 0 0;
	}
	.or-gone-archive a {
		color: var(--text-2);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.or-gone-archive a:hover {
		color: var(--accent);
	}

	/* Same reasoning as the 404 button: above 768px the header's "Try Cloud" CTA is
	   visible, so demote this to a text link instead of competing with it. */
	@media (min-width: 769px) {
		.or-gone-btn {
			height: auto;
			padding: 0;
			background: none;
			border-radius: 0;
			color: var(--accent);
			box-shadow: none;
		}
		.or-gone-btn:hover {
			background: none;
			box-shadow: none;
			color: var(--accent-press);
			text-decoration: underline;
			text-underline-offset: 4px;
		}
	}
</style>
